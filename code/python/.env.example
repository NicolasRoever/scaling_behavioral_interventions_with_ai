# Copy this file to .env and insert your own key.
OPENAI_API_KEY=

# Optional run settings:
PROS_CONS_OPENAI_MODEL=gpt-5.6-luna
PROS_CONS_MAX_WORKERS=10
PROS_CONS_CHECKPOINT_EVERY=20
PROS_CONS_MAX_ATTEMPTS=3

STRATEGIES_OPENAI_MODEL=gpt-5.6-luna
STRATEGIES_MAX_WORKERS=6
STRATEGIES_CHECKPOINT_EVERY=20
STRATEGIES_MAX_ATTEMPTS=3

# Optional path overrides:
# PROS_CONS_INPUT_PATH=/absolute/path/to/participant_transcripts.csv
# PROS_CONS_PAPER_FIGURE_PATH=/absolute/path/to/figure.pdf
# STRATEGIES_INPUT_PATH=/absolute/path/to/strategy_excerpts.csv
# STRATEGIES_OUTPUT_PATH=/absolute/path/to/checkpoint.csv
# STRATEGIES_SUMMARY_PATH=/absolute/path/to/summary.csv
# STRATEGIES_LOCAL_FIGURE_PATH=/absolute/path/to/local_figure.pdf
# STRATEGIES_PAPER_FIGURE_PATH=/absolute/path/to/paper_figure.pdf
